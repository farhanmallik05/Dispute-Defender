# ==============================================================================
# Dispute Defender Environment Configuration
# ==============================================================================

# PayPal Developer Sandbox Credentials
# Get these from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id_here

# AI Model Configuration (Vercel AI SDK)
# Supported options: gemini-2.5-flash, gemini-2.5-pro, gpt-4o, gpt-4o-mini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Application Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# SQLite Database Path
DATABASE_URL=sqlite.db
